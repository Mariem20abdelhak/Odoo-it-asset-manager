<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_asset_assignment_list" model="ir.ui.view">
        <field name="name">it.asset.assignment.list</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <list string="Affectations" decoration-muted="not is_active">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_active" widget="boolean_toggle" string="Active"/>
                <button name="action_return_asset" string="Retourner" type="object"
                        icon="fa-undo" invisible="not is_active"/>
            </list>
        </field>
    </record>
    <record id="view_it_asset_assignment_form" model="ir.ui.view">
        <field name="name">it.asset.assignment.form</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <form string="Affectation">
                <group>
                    <group>
                        <field name="asset_id"/>
                        <field name="employee_id"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>
                <field name="notes" placeholder="Notes sur cette affectation…"/>
            </form>
        </field>
    </record>
    <record id="action_it_asset_assignment" model="ir.actions.act_window">
        <field name="name">Affectations actives</field>
        <field name="res_model">it.asset.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_active','=',True)]</field>
    </record>
</odoo>
