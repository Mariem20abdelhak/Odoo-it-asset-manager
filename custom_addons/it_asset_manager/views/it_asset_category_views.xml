<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_asset_category_list" model="ir.ui.view">
        <field name="name">it.asset.category.list</field>
        <field name="model">it.asset.category</field>
        <field name="arch" type="xml">
            <list string="Catégories">
                <field name="name"/>
                <field name="code"/>
                <field name="asset_count" string="Assets"/>
            </list>
        </field>
    </record>
    <record id="view_it_asset_category_form" model="ir.ui.view">
        <field name="name">it.asset.category.form</field>
        <field name="model">it.asset.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object"
                                class="oe_stat_button" icon="fa-laptop">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description de la catégorie…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_it_asset_category" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">it.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
