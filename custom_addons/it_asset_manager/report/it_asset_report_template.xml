<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_it_asset_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="asset">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Fiche Asset IT — <span t-field="asset.reference"/></h2>
                    <hr/>

                    <div class="row mt-4">
                        <div class="col-6">
                            <h4>Identification</h4>
                            <table class="table table-sm">
                                <tr><th>Nom</th><td><t t-esc="asset.name"/></td></tr>
                                <tr><th>Référence</th><td><t t-esc="asset.reference"/></td></tr>
                                <tr><th>Catégorie</th><td><t t-esc="asset.category_id.name"/></td></tr>
                                <tr><th>Marque</th><td><t t-esc="asset.brand or '—'"/></td></tr>
                                <tr><th>Modèle</th><td><t t-esc="asset.model_name or '—'"/></td></tr>
                                <tr><th>N° de série</th><td><t t-esc="asset.serial_number or '—'"/></td></tr>
                                <tr><th>Condition</th><td><t t-esc="dict(asset._fields['condition'].selection).get(asset.condition, '')"/></td></tr>
                            </table>
                        </div>
                        <div class="col-6">
                            <h4>Affectation &amp; État</h4>
                            <table class="table table-sm">
                                <tr><th>État</th><td><t t-esc="dict(asset._fields['state'].selection).get(asset.state, '')"/></td></tr>
                                <tr><th>Employé affecté</th><td><t t-esc="asset.employee_id.name or '—'"/></td></tr>
                                <tr><th>Emplacement</th><td><t t-esc="asset.location or '—'"/></td></tr>
                                <tr><th>Fournisseur</th><td><t t-esc="asset.supplier_id.name or '—'"/></td></tr>
                            </table>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <h4>Garantie &amp; Financier</h4>
                            <table class="table table-sm">
                                <tr><th>Date d'achat</th><td><t t-esc="asset.purchase_date or '—'"/></td></tr>
                                <tr><th>Fin de garantie</th><td><t t-esc="asset.warranty_end_date or '—'"/></td></tr>
                                <tr>
                                    <th>Statut garantie</th>
                                    <td>
                                        <t t-esc="dict(asset._fields['warranty_status'].selection).get(asset.warranty_status, '')"/>
                                        <t t-if="asset.warranty_status == 'expiring'">
                                            ⚠ (<t t-esc="asset.days_until_warranty_end"/> jours)
                                        </t>
                                    </td>
                                </tr>
                                <tr><th>Prix d'achat</th><td><t t-field="asset.purchase_price" t-options='{"widget": "monetary", "display_currency": asset.currency_id}'/></td></tr>
                            </table>
                        </div>
                    </div>

                    <t t-if="asset.assignment_ids">
                        <h4 class="mt-3">Historique des affectations</h4>
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Employé</th>
                                    <th>Date début</th>
                                    <th>Date fin</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="asset.assignment_ids" t-as="asgn">
                                    <tr>
                                        <td><t t-esc="asgn.employee_id.name"/></td>
                                        <td><t t-esc="asgn.date_start"/></td>
                                        <td><t t-esc="asgn.date_end or '—'"/></td>
                                        <td><t t-esc="'Oui' if asgn.is_active else 'Non'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <t t-if="asset.notes">
                        <h4 class="mt-3">Notes techniques</h4>
                        <div t-field="asset.notes"/>
                    </t>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
